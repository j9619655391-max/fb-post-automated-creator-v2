# Application Settings
APP_NAME=Content Automation Platform
APP_VERSION=1.0.0
DEBUG=false

# Database
DATABASE_URL=sqlite:///./content_platform.db

# API
API_PREFIX=/api/v1

# Meta/Facebook OAuth (single App; do not commit .env with real values)
# FACEBOOK_APP_ID=           # From Meta Developer Console
# FACEBOOK_APP_SECRET=       # From Meta App → Settings
# FACEBOOK_REDIRECT_URI=     # Your callback URL – must match Meta "Valid OAuth Redirect URIs"
#   Local: http://localhost:8000/api/v1/auth/facebook/callback
# TOKEN_ENCRYPTION_KEY=      # Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   Or: python -m scripts.generate_encryption_key   (see docs/FACEBOOK_OAUTH_SETUP.md)

# LinkedIn OAuth
# LINKEDIN_CLIENT_ID=       # From LinkedIn Developer Portal
# LINKEDIN_CLIENT_SECRET=   # From LinkedIn Developer Portal
# LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# Cron (server-side only; do not expose)
# CRON_SECRET=  # Secret for POST /api/v1/cron/run

# AI provider selection: gemini (default) or openrouter
AI_PROVIDER=gemini
AI_FALLBACK_ENABLED=false
AI_FAILURE_ALERT_THRESHOLD=3
AI_FAILURE_ALERT_WINDOW_MINUTES=60

# Gemini API (optional – for AI-generated content themes)
# GEMINI_API_KEY=  # Get key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_COST_PER_MILLION_USD=0.30
GEMINI_OUTPUT_COST_PER_MILLION_USD=2.50

# OpenRouter API (optional; keep the key server-side and never commit .env)
# OPENROUTER_API_KEY=  # Get key at https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
# Use a specific currently available free model with the :free suffix if desired.
# OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Content Automation Platform
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_INPUT_COST_PER_MILLION_USD=0.0
OPENROUTER_OUTPUT_COST_PER_MILLION_USD=0.0

# Celery + Redis (for scheduled posts; run: redis-server, then celery -A app.scheduler worker -l info)
# CELERY_BROKER_URL=redis://localhost:6379/0
